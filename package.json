{
  "name": "the-ref-framework",
  "version": "0.4.1",
  "description": "React Engine Framework for Express",
  "main": "lib/index.js",
  "author": "Zlynt <contact@zlyntlab.com> (https://zlyntlab.com)",
  "license": "MIT",
  "scripts": {
    "build": "rimraf lib && tsc",
    "format": "prettier --write \"src/**/*.ts\" \"src/**/*.js\"",
    "test": "npm run build && nodemon test/index.ts",
    "dev": "cross-env NODE_ENV=development nodemon --watch src --watch example/hello-world/src --ext ts,tsx --exec \"node -r dotenv/config -r ./example/hello-world/register.js\" example/hello-world/src/index.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Zlynt/ref"
  },
  "homepage": "https://github.com/Zlynt/ref",
  "bugs": {
    "url": "https://github.com/Zlynt/ref/issues"
  },
  "files": [
    "lib/**/*",
    "README.md"
  ],
  "dependencies": {
    "@babel/core": "^8.1.0",
    "@babel/parser": "^8.1.0",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.7",
    "@babel/register": "^8.0.6",
    "babel-loader": "^10.1.1",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "prop-types": "^15.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "tsc-prog": "^2.3.0",
    "typescript": "^7.0.2",
    "webpack": "^5.112.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.4",
    "ts-node": "^10.9.2"
  },
  "resolutions": {
    "@types/react": "^19.3.0"
  }
}
